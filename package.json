  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:sandbox": "tsx scripts/dev-sandbox.ts",
    "dev:demo-package": "tsx scripts/dev-demo-package.ts",
    "start:hosted-demo": "tsx scripts/start-hosted-demo.ts",
    "db:create-sandbox": "tsx scripts/create-dev-sandbox-db.ts",
    "db:create-demo-package": "tsx scripts/create-demo-package-db.ts",
    "db:preflight": "tsx scripts/db-preflight.ts",
    "db:preflight:sandbox": "tsx scripts/db-preflight.ts --database file:./data/dev-sandbox.db --require-sandbox",
    "db:inventory:v3-3": "tsx scripts/migrations/v3_3_security_inventory.ts --database file:./data/dev-sandbox.db",
    "db:security-seed:v3-3": "tsx scripts/migrations/v3_3_security_seed_backfill.ts",
    "db:demo-seed:v3-3": "tsx scripts/migrations/v3_3_demo_workspace_seed.ts",
    "db:demo-001-story:v3-3": "tsx scripts/migrations/v3_3_demo_001_story_polish.ts",
    "db:demo-003-story:v3-3": "tsx scripts/migrations/v3_3_demo_003_operating_model_showcase.ts",
    "auth:bootstrap-owner": "tsx scripts/auth-bootstrap-owner.ts",
    "auth:bootstrap-demo": "tsx scripts/auth-bootstrap-demo.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:i18n-config": "tsx scripts/check-configured-i18n.ts",
    "setup:pdf": "playwright install chromium"
